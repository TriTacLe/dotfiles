# Per-machine shell variables. Copy to .env in the repo root (gitignored).
# .zshrc sources it with set -a at startup, so every line is exported.
#   cp arch/templates/env.example .env

# Project shortcuts (each alias is only defined when the dir exists)
# PROJECTS_DIR="$HOME/Desktop/personal"
# ORBIT_DIR="$HOME/Desktop/orbit"
# MOENMARIN_DIR="$HOME/Desktop/moen-marin"
# DATAING_DIR="$HOME/Desktop/dataing"

# Git identity (prefer includeIf in .gitconfig - use this only as fallback)
# GIT_USER_EMAIL="you@example.com"

# GPU env vars (uncomment on NVIDIA machines)
# LIBVA_DRIVER_NAME=nvidia
# GBM_BACKEND=nvidia-drm
# __GLX_VENDOR_LIBRARY_NAME=nvidia

# If oh-my-zsh is installed separately, protect stowed .zshrc with:
#   KEEP_ZSHRC=yes RUNZSH=no CHSH=no sh -c "$(curl -fsSL https://...install.sh)"
