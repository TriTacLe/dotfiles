# Machine-specific overrides - copy to ~/.env (gitignored, sourced at shell startup)
# Usage: cp arch/templates/env.example ~/.env   (install.sh does this automatically)

# Desktop paths
# PERSONAL_DIR="$HOME/Desktop/personal"
# NTNU_DIR="$HOME/Desktop/ntnu"
# WORK_DIR="$HOME/Desktop/work"

# Git identity (prefer includeIf in .gitconfig - use this only as fallback)
# GIT_USER_EMAIL="you@example.com"

# GPU env vars (uncomment on NVIDIA machines)
# LIBVA_DRIVER_NAME=nvidia
# GBM_BACKEND=nvidia-drm
# __GLX_VENDOR_LIBRARY_NAME=nvidia

# If oh-my-zsh is installed separately, protect stowed .zshrc with:
#   KEEP_ZSHRC=yes RUNZSH=no CHSH=no sh -c "$(curl -fsSL https://...install.sh)"
