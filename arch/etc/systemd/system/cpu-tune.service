[Unit]
# thermald only reacts once the package is already hot. In a chassis this thin
# that means the fan is pinned before anything throttles, so cap the ceiling up
# front instead of waiting for the thermal trip.
# No After=multi-user.target: this unit is WantedBy that target, so ordering it
# after the target it belongs to would push the cap to the tail of boot.
Description=Cap CPU boost and bias for lower fan noise

[Service]
Type=oneshot
RemainAfterExit=yes
# Every write guards its own target and ends with exit 0. Without that the unit
# fails on AMD, or on Intel booted with intel_pstate=disable, and the installer
# runs systemctl enable --now under set -e, so a failed unit aborts the install.
ExecStart=/bin/sh -c '[ -w /sys/devices/system/cpu/intel_pstate/max_perf_pct ] && echo 80 > /sys/devices/system/cpu/intel_pstate/max_perf_pct; exit 0'
ExecStart=/bin/sh -c 'for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do [ -w "$f" ] && echo balance_power > "$f"; done; exit 0'
# max_perf_pct caps frequency, not power, so all-core load still pulls the
# firmware PL1 of 70 W and parks the package at 99 C. Cap the sustained limit
# instead. PL2 (constraint_1) is left alone so short bursts stay fast.
ExecStart=/bin/sh -c '[ -w /sys/class/powercap/intel-rapl:0/constraint_0_power_limit_uw ] && echo 45000000 > /sys/class/powercap/intel-rapl:0/constraint_0_power_limit_uw; exit 0'

[Install]
WantedBy=multi-user.target
