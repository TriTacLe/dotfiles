[Unit]
# Firmware ships the RAPL long-term limit at 70 W on a 45 W part, so sustained
# all-core load sits about 25 W above what this chassis can shed and the fan
# pins itself trying to close a gap that cannot close. thermald only reacts once
# the package is already hot, which is far too late to keep it quiet.
# Package watts are the only knob TLP has no setting for, so this unit is now
# just that one write. The pstate ceiling and EPP moved to tlp.d/01-power.conf,
# where they can differ between AC and battery.
# No After=multi-user.target: this unit is WantedBy that target, so ordering it
# after the target it belongs to would push the cap to the tail of boot.
Description=Cap CPU package power for lower fan noise

[Service]
Type=oneshot
RemainAfterExit=yes
# Guarded and ending in exit 0. Without that the unit fails on AMD or on any
# machine without intel-rapl, and the installer runs systemctl enable --now
# under set -e, so a failed unit would abort the whole install.
# 45 W is the chip's rated TDP. short_term is left alone, so bursts still peak
# at the firmware's 125 W and only sustained load is bounded.
ExecStart=/bin/sh -c 'd=/sys/class/powercap/intel-rapl:0; [ -w "$d/constraint_0_power_limit_uw" ] && [ "$(cat "$d/constraint_0_name" 2>/dev/null)" = long_term ] && echo 45000000 > "$d/constraint_0_power_limit_uw"; exit 0'

[Install]
WantedBy=multi-user.target
