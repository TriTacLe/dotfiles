# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Arch package cache
*.pkg.tar.zst

# Secrets + per-machine config (never tracked)
.zshenv.secrets
.env.secrets
.env

# Per-person profiles (example and README are tracked)
profiles/*
!profiles/README.md
!profiles/example/
!profiles/example/**

# Private repo names - not tracked
claude-config/repos.json

# Claude config lives in the claude-config submodule, never at repo root
.claude/
.mcp.json
.playwright-mcp/

# Claude Code sandbox bind-mount targets. It needs a file to mount read-only
# over each deny-list path, so it creates an empty one where none exists.
# Deleting them does not stick. Root-anchored so the stowed copies still track.
/.bashrc
/.bash_profile
/.gitconfig
/.idea
/.profile
/.ripgreprc
/.vscode
/.zprofile
/.zshrc

# Regenerated by gtk-update-icon-cache whenever the stowed icon tree changes
shared/stow/scripts/.local/share/icons/hicolor/icon-theme.cache

# OS artifacts
Thumbs.db
ehthumbs.db
server/etc/nginx/
*.log

# Go writes telemetry state under the stowed .config; it is per machine.
shared/stow/nvim/.config/go/

# Private keys, by shape rather than by name
*.pem
*.key
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
.ssh/
shared/stow/nvim/.config/nvim/lazy-lock.json
!profiles/tri/
