# Copied to profiles/<name>/profile.env on first install and symlinked to
# <repo>/.env. The shell sources it with set -a, so every line is exported.

# Project shortcuts. Each alias is only defined when the directory exists.
# PROJECTS_DIR="$HOME/Desktop/personal"
# ORBIT_DIR="$HOME/Desktop/orbit"
# MOENMARIN_DIR="$HOME/Desktop/moen-marin"
# DATAING_DIR="$HOME/Desktop/dataing"

# Git identity lives in gitconfig.local, not here.

# Claude config. Leave both unset to use the bundled claude-config submodule
# when it is initialized. Set one of these to use your own:
# CLAUDE_CONFIG_REPO="git@github.com:you/claude-config.git"
# CLAUDE_CONFIG_DIR="$HOME/.claude"
