# Global false-positive allowlist for the pre-push secrets hook.
# One ERE pattern per line. Lines matching any pattern are skipped.

# Password/secret variable receiving value from a function/method call
# e.g. app_password = cfg.gmail.resolve()  OR  password = page.locator("...")
# Note: \s and \w don't work in bash [[ =~ ]] - must use POSIX classes
password[[:space:]]*=[[:space:]]*[[:alnum:]_.]*\(
secret[[:space:]]*=[[:space:]]*[[:alnum:]_.]*\(
api_key[[:space:]]*=[[:space:]]*[[:alnum:]_.]*\(
access_token[[:space:]]*=[[:space:]]*[[:alnum:]_.]*\(
auth_token[[:space:]]*=[[:space:]]*[[:alnum:]_.]*\(

# Keyword argument self-assignment: foo_password=foo_password
# Safe because both sides are the same variable name
# Note: no \b anchors - underscore is a word char so \bpassword\b won't match inside app_password
password[[:space:]]*=[[:space:]]*[[:alnum:]_]*password[[:alnum:]_]*
secret[[:space:]]*=[[:space:]]*[[:alnum:]_]*secret[[:alnum:]_]*
api_key[[:space:]]*=[[:space:]]*[[:alnum:]_]*api_key[[:alnum:]_]*
access_token[[:space:]]*=[[:space:]]*[[:alnum:]_]*access_token[[:alnum:]_]*

# Type annotations in function signatures
# e.g.  def foo(app_password: str, ...)
password[[:space:]]*:[[:space:]]*(str|bytes|Optional|str[[:space:]]*\|)
secret[[:space:]]*:[[:space:]]*(str|bytes|Optional|str[[:space:]]*\|)
api_key[[:space:]]*:[[:space:]]*(str|bytes|Optional|str[[:space:]]*\|)
