#!/bin/bash
# Blocks git push if staged diff contains likely secrets.
# Checks the diff of commits being pushed (not just staged files).

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

remote="$1"
url="$2"

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"

ALLOWLIST_FILES=()
[[ -n "$HOOK_DIR" ]] && ALLOWLIST_FILES+=("$HOOK_DIR/secret-allowlist.regex")
[[ -n "$REPO_ROOT" ]] && ALLOWLIST_FILES+=(
    "$REPO_ROOT/.git-hooks/secret-allowlist.regex"
    "$REPO_ROOT/.secrets.allowlist"
)

ALLOWLIST_RE=()

load_allowlist_file() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ "$line" =~ ^[[:space:]]*$ ]] && continue
        ALLOWLIST_RE+=("$line")
    done < "$file"
}

for file in "${ALLOWLIST_FILES[@]}"; do
    load_allowlist_file "$file"
done

builtin_fp_re='example|placeholder|your_|<.*>|environ\.get|os\.environ|getenv|process\.env|ENV\[|\$\{[A-Z0-9_]+\}|\$\{\{|assert\s'
assignment_re='(password|passwd|secret|api_key|apikey|access_token|auth_token|client_secret|private_key|bearer)\s*[:=]\s*["\x27]?.{6,}'
token_prefix_re='(ghp_[A-Za-z0-9]{36}|ghs_[A-Za-z0-9]{36}|sk-[A-Za-z0-9]{32,}|xox[baprs]-[A-Za-z0-9-]+|AKIA[A-Z0-9]{16}|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,})'
private_key_re='-----BEGIN (RSA|EC|DSA|OPENSSH) PRIVATE KEY-----'

is_allowlisted() {
    local line="$1"
    [[ "$line" =~ $builtin_fp_re ]] && return 0
    for re in "${ALLOWLIST_RE[@]}"; do
        [[ "$line" =~ $re ]] && return 0
    done
    return 1
}

should_skip_line() {
    local line="$1"
    [[ "$line" =~ ^[[:space:]]*# ]] && return 0
    [[ "$line" =~ ^[[:space:]]*// ]] && return 0
    [[ "$line" =~ ^[[:space:]]*$ ]] && return 0
    [[ "$line" =~ \#[[:space:]]*pragma:[[:space:]]*allowlist[[:space:]]*secret ]] && return 0
    is_allowlisted "$line" && return 0
    return 1
}

while read local_ref local_sha remote_ref remote_sha; do
    if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
        continue  # branch deletion
    fi

    if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi

    diff=$(git diff --no-color "$range" 2>/dev/null)
    [[ -z "$diff" ]] && diff=$(git show "$local_sha" 2>/dev/null)

    found=()

    # High-signal patterns: assignment-style leaks
    while IFS= read -r line; do
        [[ "$line" =~ ^\+ ]] || continue  # only added lines
        line_content="${line:1}"

        [[ "$line_content" =~ ^\+\+\+ ]] && continue
        [[ "$line_content" =~ ^@@ ]] && continue
        should_skip_line "$line_content" && continue

        if echo "$line_content" | grep -qiE "$assignment_re"; then
            found+=("$line_content")
        fi

        # Service-specific token prefixes
        if echo "$line_content" | grep -qE "$token_prefix_re"; then
            found+=("$line_content")
        fi

        # SSH private key header
        if echo "$line_content" | grep -qE -- "$private_key_re"; then
            found+=("$line_content")
        fi
    done <<< "$diff"

    if [[ ${#found[@]} -gt 0 ]]; then
        echo -e "${RED}[pre-push] Blocked: possible secret in push to $remote ($url)${NC}" >&2
        echo -e "${YELLOW}Flagged lines:${NC}" >&2
        for line in "${found[@]}"; do
            echo "  $line" >&2
        done
        echo "" >&2
        echo "To suppress a false positive: add '# pragma: allowlist secret' inline, or add a pattern to .secrets.allowlist" >&2
        exit 1
    fi
done

exit 0
