#!/bin/bash
# Scan the commits about to be pushed for secrets with gitleaks.
# Suppress a known false positive with a trailing "gitleaks:allow" comment,
# or add a .gitleaks.toml to the repo root.

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "[pre-push] gitleaks not installed, skipping secret scan" >&2
    exit 0
fi

repo="$(git rev-parse --show-toplevel)"
config="${XDG_CONFIG_HOME:-$HOME/.config}/git/gitleaks.toml"
zero=0000000000000000000000000000000000000000
status=0

while read -r _ local_sha _ remote_sha; do
    [[ "$local_sha" == "$zero" ]] && continue   # branch deletion
    if [[ "$remote_sha" == "$zero" ]]; then
        # New ref on the remote: scan everything not on any remote yet.
        opts="$local_sha --not --remotes"
    else
        opts="$remote_sha..$local_sha"
    fi
    gitleaks git --no-banner --redact -c "$config" --log-opts="$opts" "$repo" || status=1
done

[[ $status -ne 0 ]] && echo "[pre-push] blocked: possible secret in the commits above" >&2
exit $status
